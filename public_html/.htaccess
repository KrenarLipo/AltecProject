# Larger upload limits for the admin media uploader (images/PDFs/video slides)
php_value upload_max_filesize 40M
php_value post_max_size 45M

RewriteEngine On

# API front controller
RewriteCond %{REQUEST_URI} ^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api/index.php?__route=$1 [QSA,L]

# Admin SPA (built React app) — serve real files/assets as-is, fall back to index.html for client-side routes
RewriteCond %{REQUEST_URI} ^/admin/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^admin/(.*)$ admin/index.html [L]

# Clean URLs for public pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^news/([a-zA-Z0-9-]+)/?$ news.php?slug=$1 [L,QSA]
RewriteRule ^works/([0-9]+)/?$ works.php?id=$1 [L,QSA]
RewriteRule ^about/?$ about.php [L]
RewriteRule ^partners/?$ partners.php [L]
RewriteRule ^ac-sales-installation/?$ ac-sales-installation.php [L]
RewriteRule ^reconstruction-furnishing/?$ reconstruction-furnishing.php [L]
RewriteRule ^works/?$ works.php [L]
RewriteRule ^news/?$ news.php [L]
RewriteRule ^contact/?$ contact.php [L]
